generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum ExamMode {
  class11
  class12
  jee_mains
  jee_advanced
}

enum SessionStatus {
  generating
  active
  auto_submitted
  completed
}

enum QuestionType {
  mcq
  assertion_reason
  integer
  multiple_correct
  short_answer
  long_answer
  case_based
}

enum Difficulty {
  easy
  medium
  hard
}

/// A student is identified by their session cookie, never by email.
/// Email / parent email are optional contact fields used only for result reports.
model Student {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String?
  parentEmail  String?
  createdAt    DateTime      @default(now())
  sessions     ExamSession[]
  authSessions AuthSession[]

  @@index([email])
}

/// Login session. Only the SHA-256 of the cookie token is stored, so a database
/// leak does not leak usable sessions.
model AuthSession {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String   @unique
  studentId String   @db.ObjectId
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([studentId])
}

model ExamSession {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  studentId      String          @db.ObjectId
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mode           ExamMode
  subject        String
  chapters       Json
  totalMarks     Int
  duration       Int
  startTime      DateTime        @default(now())
  endTime        DateTime?
  status         SessionStatus   @default(active)
  violationCount Int             @default(0)
  autoSubmitted  Boolean         @default(false)
  questions      Question[]
  answers        StudentAnswer[]
  result         ExamResult?
  createdAt      DateTime        @default(now())

  @@index([studentId, createdAt])
}

model Question {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  sessionId      String          @db.ObjectId
  session        ExamSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionNumber Int
  section        String
  type           QuestionType
  questionText   String
  options        Json?
  correctAnswer  String
  solution       String
  marks          Int
  negativeMarks  Float           @default(0)
  chapterName    String
  difficulty     Difficulty
  imageUrl       String?
  hasSubParts    Boolean         @default(false)
  subParts       Json?
  answers        StudentAnswer[]
  createdAt      DateTime        @default(now())

  @@index([sessionId, questionNumber])
}

model StudentAnswer {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  questionId     String      @db.ObjectId
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sessionId      String      @db.ObjectId
  session        ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answerText     String?
  answerImageUrl String?
  isCorrect      Boolean?
  marksAwarded   Float?
  aiFeedback     String?
  modelAnswer    String?
  submittedAt    DateTime    @default(now())

  /// One answer per question per exam — re-submits update in place, no races.
  @@unique([sessionId, questionId])
}

model ExamResult {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  sessionId        String      @unique @db.ObjectId
  session          ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  totalMarks       Int
  marksObtained    Float
  percentage       Float
  sectionBreakdown Json
  chapterBreakdown Json
  strengths        Json
  weaknesses       Json
  recommendations  Json
  estimatedGrade   String?
  emailSent        Boolean     @default(false)
  generatedAt      DateTime    @default(now())
}

/// Fixed-window counters for rate limits and AI budgets (no extra service needed).
model RateLimit {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  key     String   @unique
  count   Int
  resetAt DateTime
}

/// Mistake notebook: every question a student got wrong becomes a flashcard,
/// scheduled with SM-2 spaced repetition (the algorithm behind Anki).
model ReviewCard {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId     String   @db.ObjectId
  questionId    String   @db.ObjectId
  sessionId     String   @db.ObjectId
  mode          ExamMode
  subject       String
  chapterName   String
  type          QuestionType
  questionText  String
  options       Json?
  correctAnswer String
  solution      String
  ease          Float    @default(2.5)
  intervalDays  Int      @default(0)
  reps          Int      @default(0)
  lapses        Int      @default(0)
  dueAt         DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([studentId, questionId])
  @@index([studentId, dueAt])
}
