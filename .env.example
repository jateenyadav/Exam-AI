# Copy to .env.local for development. In production set these in Vercel → Settings → Environment Variables.
# Never commit real values.

# MongoDB (Atlas free M0 works). Prisma + MongoDB needs a replica set — Atlas provides one.
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/examace"

# --- AI (at least one) ---
# Free: https://aistudio.google.com/apikey  (Gemini free tier, supports image grading)
GEMINI_API_KEY=""
# Alias that always points at Google's current Flash model, so a retired model id can't break the app.
GEMINI_MODEL="gemini-flash-latest"

# Optional fallback: https://openrouter.ai/keys — pick any model id, e.g. a vision-capable ":free" model
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
# AI_PROVIDER="gemini"   # force the primary provider

# --- Abuse / cost limits (defaults shown) ---
# PAPERS_PER_STUDENT_PER_DAY=5
# PAPERS_GLOBAL_PER_DAY=300
# SIGNUPS_PER_IP_PER_HOUR=20
# EMAILS_PER_STUDENT_PER_DAY=3

# Read-only admin status page at /settings (min 16 chars). Leave empty to disable.
ADMIN_TOKEN=""

# --- Optional: e-mail result reports ---
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASS=""
EMAIL_FROM="ExamAce <noreply@example.com>"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
